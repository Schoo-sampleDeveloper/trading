{# ─────────────────────────────────────────
   Macro: render one article card (Bloomberg/Koyfin-style v2)
   Always visible: imp-indicator + category chip + impact chip + title + data-grid + points
   Breakdown panel: importance reasoning (animated bars)
   Expandable: summary + background + market_view + scenarios + investment_angle + watch_points + historical_context
───────────────────────────────────────── #}
{% macro render_card(art, uid, is_featured=false) %}
{% set imp = art.importance | default(3) | int %}
{% set sc = art.scenarios | default({}) %}
{% set mv = art.market_view | default({}) %}
{% set ia = art.investment_angle | default({}) %}
{# scenarios の新形式(dict)と旧形式(string)の両方に対応 #}
{% if sc.base is mapping %}
  {% set sc_base_text = sc.base.text | default('') %}
  {% set sc_base_prob = sc.base.probability | default('60%') %}
{% else %}
  {% set sc_base_text = sc.base | default('') %}
  {% set sc_base_prob = '60%' %}
{% endif %}
{% if sc.bull is mapping %}
  {% set sc_bull_text = sc.bull.text | default('') %}
  {% set sc_bull_prob = sc.bull.probability | default('25%') %}
{% else %}
  {% set sc_bull_text = sc.bull | default('') %}
  {% set sc_bull_prob = '25%' %}
{% endif %}
{% if sc.bear is mapping %}
  {% set sc_bear_text = sc.bear.text | default('') %}
  {% set sc_bear_prob = sc.bear.probability | default('15%') %}
{% else %}
  {% set sc_bear_text = sc.bear | default('') %}
  {% set sc_bear_prob = '15%' %}
{% endif %}
{% set has_sc = sc_base_text or sc_bull_text or sc_bear_text %}
{% set has_mv = mv.price_levels or mv.trend or mv.drivers %}
{% set has_ia = ia.long_term or ia.swing_trade or ia.risk_factors %}
{% set historical_text = art.historical_context | default(art.historical_analog | default('')) %}
{% set has_expandable = art.summary or art.background or has_mv or has_sc or has_ia or art.watch_points or historical_text %}
{# impact → CSS クラスと表示ラベルのマッピング #}
{% set impact_class = 'bullish' if art.impact in ('強気', 'bullish') else 'bearish' if art.impact in ('弱気', 'bearish') else 'neutral' %}
{% set impact_label = '▲ 強気' if impact_class == 'bullish' else '▼ 弱気' if impact_class == 'bearish' else '— 中立' %}
{# 重要度スコア内訳 #}
{% if art.importance_detail is defined and art.importance_detail %}
{% set bd = art.importance_detail.breakdown | default({}) %}
{% set mkt = bd.market_reaction | default({}) %}
{% set str_imp = bd.structural | default({}) %}
{% set ai_imp = bd.ai | default({}) %}
{% set mkt_bar = [(mkt.reaction_score | default(0)) * 10, 100] | min | int %}
{% set str_bar = [(str_imp.score | default(3)) * 10, 100] | min | int %}
{% set ai_bar  = [(ai_imp.score  | default(5)) * 10, 100] | min | int %}
{% endif %}
<article class="card-v2{% if is_featured %} featured{% endif %}"
         data-importance="{{ imp }}"
         data-category="{{ art.category }}"
         data-impact="{{ impact_class }}"
         data-link="{{ art.link | default('') }}"
         id="card-{{ uid }}">

  <!-- ヘッダー: 重要度・カテゴリ・影響 -->
  <header class="card-v2__header">
    <div class="card-v2__meta">
      <span class="imp-indicator imp-indicator--{{ imp }}"
            role="button"
            aria-label="重要度{{ imp }}の根拠を表示"
            onclick="toggleBreakdown('{{ uid }}')">
        <span class="imp-indicator__bars">
          {% for i in range(5) %}
          <span class="imp-indicator__bar {% if i < imp %}is-active{% endif %}"></span>
          {% endfor %}
        </span>
        <span class="imp-indicator__score">{% if art.importance_detail is defined and art.importance_detail %}{{ art.importance_detail.final_score }}{% else %}{{ imp * 2 }}.0{% endif %}</span>
      </span>
      <span class="cat-chip">{{ art.category_label | default(category_labels.get(art.category, art.category)) }}</span>
      <span class="impact-chip impact-chip--{{ impact_class }}">{{ impact_label }}</span>
    </div>
    <button class="bookmark-btn" data-link="{{ art.link | default('') }}" onclick="toggleBookmark(this)" aria-label="ブックマーク">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 2v12l5-3 5 3V2H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </button>
  </header>

  <!-- メイン: タイトル + データグリッド + ポイント -->
  <div class="card-v2__main">
    <h3 class="card-v2__title">{{ art.headline | default(art.title) }}</h3>

    {% if art.key_data %}
    <div class="data-grid">
      {% for kd in art.key_data[:3] %}
      {% set val_str = kd.value | string | trim %}
      <div class="data-cell">
        <div class="data-cell__label">{{ kd.label }}</div>
        <div class="data-cell__value{% if val_str[:1] == '+' %} is-positive{% elif val_str[:1] == '-' %} is-negative{% endif %}">{{ kd.value }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if art.points %}
    <ul class="points-list">
      {% for p in art.points[:3] %}
      <li class="points-list__item">{{ p }}</li>
      {% endfor %}
    </ul>
    {% elif art.summary %}
    <ul class="points-list">
      <li class="points-list__item">{{ art.summary }}</li>
    </ul>
    {% endif %}
  </div>

  <!-- 内訳パネル: 重要度の根拠 (デフォルト非表示) -->
  {% if art.importance_detail is defined and art.importance_detail %}
  <div class="breakdown-v2" id="breakdown-{{ uid }}" hidden>
    {% if art.importance_detail.transparency_text %}
    <div class="breakdown-v2__summary">{{ art.importance_detail.transparency_text }}</div>
    {% endif %}
    <div class="breakdown-v2__rows">
      <div class="bd-row">
        <div class="bd-row__head">
          <span class="bd-row__label">市場反応</span>
          <span class="bd-row__weight">50%</span>
        </div>
        <div class="bd-row__bar-wrap">
          <div class="bd-row__bar" data-target="{{ mkt_bar }}" style="--bar-color: var(--action);"></div>
        </div>
        <div class="bd-row__detail">
          {% if mkt.data_quality | default('unavailable') == 'unavailable' %}
          <span class="bd-row__na">データなし</span>
          {% else %}
          {{ mkt.indicator_name | default('') }}{% if mkt.change_pct is defined %}
          <span class="{% if mkt.change_pct > 0 %}is-positive{% elif mkt.change_pct < 0 %}is-negative{% endif %}">
            {{ '%+.2f' | format(mkt.change_pct | float) }}%</span>{% endif %}
          {% endif %}
        </div>
      </div>
      <div class="bd-row">
        <div class="bd-row__head">
          <span class="bd-row__label">構造的重要度</span>
          <span class="bd-row__weight">30%</span>
        </div>
        <div class="bd-row__bar-wrap">
          <div class="bd-row__bar" data-target="{{ str_bar }}" style="--bar-color: var(--importance-3);"></div>
        </div>
        <div class="bd-row__detail">
          {% if str_imp.matched_rules | default([]) | length > 0 %}
          {{ str_imp.matched_rules[0].name }}
          {% else %}
          <span class="bd-row__na">一般ニュース</span>
          {% endif %}
        </div>
      </div>
      <div class="bd-row">
        <div class="bd-row__head">
          <span class="bd-row__label">AI判断</span>
          <span class="bd-row__weight">20%</span>
        </div>
        <div class="bd-row__bar-wrap">
          <div class="bd-row__bar" data-target="{{ ai_bar }}" style="--bar-color: var(--importance-4);"></div>
        </div>
        <div class="bd-row__detail">
          <span class="bd-row__rationale">{{ ai_imp.rationale | default('') }}</span>
        </div>
      </div>
    </div>
    <div class="bd-final">
      総合スコア: <strong>{{ art.importance_detail.final_score }}</strong> / 10
    </div>
  </div>
  {% endif %}

  <!-- フッター: 詳細展開ボタン + ソース -->
  <footer class="card-v2__footer">
    {% if has_expandable %}
    <button class="card-v2__expand" onclick="toggleCard(this)" aria-expanded="false">
      <span class="card-v2__expand-text">詳細を見る</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="card-v2__expand-icon">
        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    {% else %}
    <span></span>
    {% endif %}
    <span class="card-v2__source">{{ art.source }}</span>
  </footer>

  <!-- 詳細セクション (デフォルト非表示) -->
  {% if has_expandable %}
  <div class="card-v2__details" id="details-{{ uid }}" hidden>

    {% if art.summary %}
    <div class="detail-section">
      <div class="detail-label">📝 要約</div>
      <div class="detail-text">{{ art.summary }}</div>
    </div>
    {% endif %}

    {% if art.background %}
    <div class="detail-section">
      <div class="detail-label">💡 背景</div>
      <div class="detail-text">{{ art.background }}</div>
    </div>
    {% endif %}

    {% if has_mv %}
    <div class="detail-section">
      <div class="detail-label">📈 マーケットの見方</div>
      <div class="mv-grid">
        {% if mv.price_levels %}
        <div class="mv-row">
          <span class="mv-key">価格水準</span>
          <span class="detail-text">{{ mv.price_levels }}</span>
        </div>
        {% endif %}
        {% if mv.trend %}
        <div class="mv-row">
          <span class="mv-key">トレンド</span>
          <span class="detail-text">{{ mv.trend }}</span>
        </div>
        {% endif %}
        {% if mv.drivers %}
        <div class="mv-row">
          <span class="mv-key">値動き要因</span>
          <span class="detail-text">{{ mv.drivers }}</span>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if has_sc %}
    <div class="detail-section">
      <div class="detail-label">🎬 シナリオ</div>
      <div class="scenario-grid">
        {% if sc_base_text %}
        <div class="scenario-cell base">
          <div class="sc-header">
            <span class="sc-label">ベース</span>
            <span class="sc-prob-text">{{ sc_base_prob }}</span>
          </div>
          <div class="sc-prob-bar"><div class="sc-prob-fill" style="width:{{ sc_base_prob }}"></div></div>
          <div class="detail-text">{{ sc_base_text }}</div>
        </div>
        {% endif %}
        {% if sc_bull_text %}
        <div class="scenario-cell bull">
          <div class="sc-header">
            <span class="sc-label">強気</span>
            <span class="sc-prob-text">{{ sc_bull_prob }}</span>
          </div>
          <div class="sc-prob-bar"><div class="sc-prob-fill" style="width:{{ sc_bull_prob }}"></div></div>
          <div class="detail-text">{{ sc_bull_text }}</div>
        </div>
        {% endif %}
        {% if sc_bear_text %}
        <div class="scenario-cell bear">
          <div class="sc-header">
            <span class="sc-label">弱気</span>
            <span class="sc-prob-text">{{ sc_bear_prob }}</span>
          </div>
          <div class="sc-prob-bar"><div class="sc-prob-fill" style="width:{{ sc_bear_prob }}"></div></div>
          <div class="detail-text">{{ sc_bear_text }}</div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if has_ia %}
    <div class="detail-section">
      <div class="detail-label">🎯 投資視点</div>
      <div class="inv-angle" data-uid="{{ uid }}">
        <div class="inv-tabs">
          {% if ia.long_term %}
          <button class="inv-tab{% if ia.long_term %} active{% endif %}" data-uid="{{ uid }}" data-tab="long_term" onclick="switchInvTab(this)">📊 長期投資</button>
          {% endif %}
          {% if ia.swing_trade %}
          <button class="inv-tab{% if not ia.long_term %} active{% endif %}" data-uid="{{ uid }}" data-tab="swing_trade" onclick="switchInvTab(this)">📈 スイング</button>
          {% endif %}
          {% if ia.risk_factors %}
          <button class="inv-tab{% if not ia.long_term and not ia.swing_trade %} active{% endif %}" data-uid="{{ uid }}" data-tab="risk_factors" onclick="switchInvTab(this)">⚠️ リスク</button>
          {% endif %}
        </div>
        {% if ia.long_term %}
        <div class="inv-panel{% if ia.long_term %} active{% endif %}" data-uid="{{ uid }}" data-panel="long_term">
          <div class="detail-text">{{ ia.long_term }}</div>
        </div>
        {% endif %}
        {% if ia.swing_trade %}
        <div class="inv-panel{% if not ia.long_term %} active{% endif %}" data-uid="{{ uid }}" data-panel="swing_trade">
          <div class="detail-text">{{ ia.swing_trade }}</div>
        </div>
        {% endif %}
        {% if ia.risk_factors %}
        <div class="inv-panel{% if not ia.long_term and not ia.swing_trade %} active{% endif %}" data-uid="{{ uid }}" data-panel="risk_factors">
          <div class="detail-text">{{ ia.risk_factors }}</div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if art.watch_points %}
    <div class="detail-section">
      <div class="detail-label">📌 注目ポイント</div>
      <ul class="watch-list">
        {% for wp in art.watch_points %}
        <li class="detail-text">{{ wp }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if historical_text %}
    <div class="detail-section">
      <div class="detail-label">📚 過去の類似局面</div>
      <div class="detail-text analog-text">{{ historical_text }}</div>
    </div>
    {% endif %}

    <div class="card-footer">
      <span>{{ art.source }} &nbsp;|&nbsp; {{ art.published.strftime('%m/%d %H:%M UTC') }}</span>
      {% if art.link %}<a href="{{ art.link }}" target="_blank" rel="noopener">元記事 →</a>{% endif %}
    </div>

  </div>
  {% endif %}

</article>
{% endmacro %}

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>マーケットニュース {{ date_str }}</title>
  <link rel="manifest" href="{{ base_url }}/manifest.json">
  <meta name="theme-color" content="#0d1117">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="マーケットニュース">
  <style>
    /* ── CSS Variables ── */
    :root {
      --bg: #0d1117; --bg2: #161b22; --bg3: #21262d; --bg4: #2d333b;
      --border: #30363d; --text: #e6edf3; --text2: #8b949e; --text3: #656d76;
      --accent: #58a6ff; --green: #3fb950; --red: #f85149;
      --yellow: #d29922; --purple: #bc8cff; --tag-bg: #1f2937;
      --card-hover: #1c2230; --font-size: 16px;

      /* ── Bloomberg/Koyfin デザインシステム (card-v2) ── */
      --bg-page: #0a0e14;
      --bg-card: #11161d;
      --bg-card-hover: #161c25;
      --bg-elevated: #1a2029;
      --border-subtle: #1f2630;
      --border-default: #2a3340;
      --text-primary: #e8edf2;
      --text-secondary: #8b95a3;
      --text-tertiary: #545d6b;
      --bullish: #00c853;
      --bullish-bg: #00c8531a;
      --bearish: #ff3b30;
      --bearish-bg: #ff3b301a;
      --neutral: #8b95a3;
      --neutral-bg: #8b95a31a;
      --action: #2196f3;
      --importance-5: #ff6b35;
      --importance-4: #ffa726;
      --importance-3: #ffd54f;
      --importance-2: #90caf9;
      --importance-1: #546e7a;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f6f8fa; --bg2: #ffffff; --bg3: #f0f2f5; --bg4: #e8ecf0;
        --border: #d0d7de; --text: #1f2328; --text2: #656d76; --text3: #8c959f;
        --accent: #0969da; --green: #1a7f37; --red: #cf222e;
        --yellow: #9a6700; --purple: #8250df; --tag-bg: #ddf4ff;
        --card-hover: #f0f6ff;
        --bg-page: #fafbfc;
        --bg-card: #ffffff;
        --bg-card-hover: #f5f7fa;
        --bg-elevated: #f0f3f7;
        --border-subtle: #e4e8ed;
        --border-default: #d0d7de;
        --text-primary: #0f1419;
        --text-secondary: #57606a;
        --text-tertiary: #8b95a3;
      }
    }
    /* Manual theme overrides */
    [data-theme="dark"] {
      --bg: #0d1117; --bg2: #161b22; --bg3: #21262d; --bg4: #2d333b;
      --border: #30363d; --text: #e6edf3; --text2: #8b949e; --text3: #656d76;
      --accent: #58a6ff; --green: #3fb950; --red: #f85149;
      --yellow: #d29922; --purple: #bc8cff; --tag-bg: #1f2937; --card-hover: #1c2230;
      --bg-page: #0a0e14; --bg-card: #11161d; --bg-card-hover: #161c25;
      --bg-elevated: #1a2029; --border-subtle: #1f2630; --border-default: #2a3340;
      --text-primary: #e8edf2; --text-secondary: #8b95a3; --text-tertiary: #545d6b;
    }
    [data-theme="light"] {
      --bg: #f6f8fa; --bg2: #ffffff; --bg3: #f0f2f5; --bg4: #e8ecf0;
      --border: #d0d7de; --text: #1f2328; --text2: #656d76; --text3: #8c959f;
      --accent: #0969da; --green: #1a7f37; --red: #cf222e;
      --yellow: #9a6700; --purple: #8250df; --tag-bg: #ddf4ff; --card-hover: #f0f6ff;
      --bg-page: #fafbfc; --bg-card: #ffffff; --bg-card-hover: #f5f7fa;
      --bg-elevated: #f0f3f7; --border-subtle: #e4e8ed; --border-default: #d0d7de;
      --text-primary: #0f1419; --text-secondary: #57606a; --text-tertiary: #8b95a3;
    }
    /* Font size classes */
    .font-s { --font-size: 14px; }
    .font-m { --font-size: 16px; }
    .font-l { --font-size: 18px; }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg); color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
      font-size: var(--font-size); line-height: 1.7;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 860px; margin: 0 auto; padding: 12px 16px; }

    /* ── Header ── */
    header {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 18px; margin-bottom: 12px;
    }
    .header-top {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
      margin-bottom: 10px;
    }
    header h1 { font-size: 1.25rem; font-weight: 700; color: var(--accent); margin-bottom: 2px; }
    header .meta { font-size: 0.82rem; color: var(--text2); }
    .header-controls {
      display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    /* Font size buttons */
    .font-btns { display: flex; gap: 4px; }
    .font-btn {
      padding: 4px 8px; border-radius: 6px; font-size: .78rem; font-weight: 700;
      cursor: pointer; border: 1px solid var(--border); background: var(--bg3);
      color: var(--text2); min-height: 32px; min-width: 32px; text-align: center;
      transition: all .15s;
    }
    .font-btn:hover, .font-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    /* Theme toggle */
    .theme-toggle {
      padding: 6px 10px; border-radius: 20px; font-size: .8rem;
      cursor: pointer; border: 1px solid var(--border); background: var(--bg3);
      color: var(--text2); min-height: 32px; transition: all .15s;
    }
    .theme-toggle:hover { background: var(--bg4); }
    /* Action buttons */
    .header-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .btn {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 6px 14px; border-radius: 20px; font-size: 0.82rem;
      font-weight: 600; cursor: pointer; border: none; min-height: 40px;
      transition: opacity .15s; text-decoration: none;
    }
    .btn:hover { opacity: .85; text-decoration: none; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-secondary { background: var(--bg3); color: var(--text); border: 1px solid var(--border); }
    .btn-bookmark { background: var(--bg3); color: var(--yellow); border: 1px solid var(--border); }
    .btn-bookmark.has-bookmarks { background: rgba(210,153,34,.12); border-color: var(--yellow); }
    #bookmark-count { font-size: .75rem; }

    /* ── Market summary box ── */
    .theme-box {
      background: linear-gradient(135deg, var(--bg2) 0%, var(--bg3) 100%);
      border: 1px solid var(--accent); border-radius: 12px;
      padding: 14px 16px; margin-bottom: 12px;
    }
    .theme-box h2 { font-size: .9rem; color: var(--accent); margin-bottom: 6px; font-weight: 700; }
    .theme-text { font-size: 0.88rem; color: var(--text); white-space: pre-wrap; line-height: 1.7; }

    /* ── Section title ── */
    .section-title {
      font-size: 1.0rem; font-weight: 700; color: var(--text);
      margin: 18px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .badge {
      background: var(--bg3); color: var(--text2);
      font-size: 0.72rem; padding: 2px 8px; border-radius: 10px;
      border: 1px solid var(--border); font-weight: 600;
    }

    /* ── Category filter tabs (sticky) ── */
    .cat-filter-wrap {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg); border-bottom: 1px solid var(--border);
      padding: 6px 0; margin-bottom: 12px;
    }
    .cat-filter-inner {
      max-width: 860px; margin: 0 auto; padding: 0 16px;
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
    }
    .cat-filter-inner::-webkit-scrollbar { display: none; }
    .cat-filter-btn {
      white-space: nowrap; padding: 5px 12px; border-radius: 14px;
      font-size: 0.78rem; font-weight: 600; cursor: pointer;
      background: var(--bg3); color: var(--text2);
      border: 1px solid var(--border); min-height: 34px;
      display: inline-flex; align-items: center; transition: all .15s;
    }
    .cat-filter-btn:hover { background: var(--bg4); color: var(--text); }
    .cat-filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* ── Filter bar (importance) ── */
    .filter-bar {
      display: flex; gap: 8px; flex-wrap: wrap;
      margin-bottom: 12px; align-items: center;
    }
    .filter-btn {
      padding: 5px 12px; border-radius: 14px; font-size: 0.8rem;
      font-weight: 600; cursor: pointer; border: 1px solid var(--border);
      background: var(--bg3); color: var(--text2); min-height: 34px;
      transition: all .15s;
    }
    .filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* ── Cards ── */
    .card {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; margin-bottom: 10px;
      transition: border-color .2s; overflow: hidden;
    }
    .card:hover { border-color: var(--accent); }
    .card.featured { border-left: 3px solid var(--accent); }
    .card[data-importance="5"] { border-left: 3px solid var(--red); }
    .card[data-importance="4"]:not(.featured) { border-left: 3px solid var(--yellow); }

    .card-always { padding: 14px 16px 10px; }
    .card-header-row {
      display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px;
    }
    .impact-emoji { font-size: 1.15rem; flex-shrink: 0; margin-top: 3px; }
    .card-header-body { flex: 1; min-width: 0; }
    .headline { font-size: 1.02rem; font-weight: 700; color: var(--text); line-height: 1.45; }

    .tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
    .tag {
      background: var(--tag-bg); color: var(--accent);
      font-size: 0.72rem; font-weight: 600;
      padding: 2px 8px; border-radius: 10px; border: 1px solid var(--border);
    }
    .tag-cat { color: var(--text2); }
    .tag.impact-強気 { color: var(--green); border-color: var(--green); background: rgba(63,185,80,.08); }
    .tag.impact-弱気 { color: var(--red); border-color: var(--red); background: rgba(248,81,73,.08); }
    .tag.impact-中立 { color: var(--yellow); border-color: var(--yellow); background: rgba(210,153,34,.08); }
    .tag.imp-5 { background: rgba(248,81,73,.12); color: var(--red); border-color: var(--red); }
    .tag.imp-4 { background: rgba(210,153,34,.12); color: var(--yellow); border-color: var(--yellow); }
    .stars { color: var(--yellow); font-size: 0.78rem; letter-spacing: 1px; }

    /* ── 重要度内訳 (why-btn + breakdown panel) ── */
    .why-btn {
      background: none; border: 1px solid var(--border);
      color: var(--text2); font-size: 0.68rem; font-weight: 600;
      padding: 2px 7px; border-radius: 10px; cursor: pointer;
      transition: background .15s, color .15s;
    }
    .why-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
    .why-btn[aria-expanded="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }

    .importance-breakdown {
      margin: 4px 16px 10px;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.78rem;
    }
    .bd-transparency {
      color: var(--text2); font-size: 0.74rem;
      margin-bottom: 8px; line-height: 1.5;
    }
    .bd-rows { display: flex; flex-direction: column; gap: 6px; }
    .bd-row {
      display: flex; align-items: center; gap: 8px;
      min-height: 22px;
    }
    .bd-label {
      flex-shrink: 0; width: 82px;
      color: var(--text3); font-size: 0.72rem;
    }
    .bd-bar-wrap {
      flex: 0 0 80px; height: 6px;
      background: var(--bg4, #30363d); border-radius: 3px; overflow: hidden;
    }
    .bd-bar {
      height: 100%; border-radius: 3px;
      background: linear-gradient(90deg, var(--accent) 0%, var(--green) 100%);
      transition: width .4s ease;
    }
    .bd-value {
      flex: 1; color: var(--text2); font-size: 0.73rem; line-height: 1.4;
    }
    .bd-note {
      font-size: 0.68rem; color: var(--yellow);
      margin-left: 4px; opacity: .8;
    }
    .bd-final {
      margin-top: 8px; padding-top: 6px;
      border-top: 1px solid var(--border);
      color: var(--text3); font-size: 0.73rem; text-align: right;
    }
    .bd-final strong { color: var(--accent); }

    /* Bookmark button */
    .bookmark-btn {
      flex-shrink: 0; background: none; border: none; cursor: pointer;
      font-size: 1.1rem; color: var(--text3); padding: 2px 4px;
      transition: color .15s, transform .15s;
    }
    .bookmark-btn:hover { color: var(--yellow); transform: scale(1.15); }
    .bookmark-btn.bookmarked { color: var(--yellow); }

    /* ── Points list ── */
    .points-list {
      list-style: none; padding: 0; margin-bottom: 10px;
    }
    .points-list li {
      font-size: .88rem; color: var(--text); line-height: 1.6;
      padding: 3px 0 3px 16px; position: relative;
    }
    .points-list li::before {
      content: '✓'; position: absolute; left: 0;
      color: var(--accent); font-weight: 700; font-size: .8rem;
    }

    .card-summary-text {
      font-size: .88rem; color: var(--text); line-height: 1.65;
      margin-bottom: 10px;
    }

    /* ── Key data badges ── */
    .key-data-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    .kd-badge {
      display: inline-flex; align-items: center;
      background: var(--bg4); border: 1px solid var(--border);
      border-radius: 6px; overflow: hidden; font-size: .78rem;
    }
    .kd-label {
      background: var(--bg3); color: var(--text2);
      padding: 3px 7px; border-right: 1px solid var(--border);
      font-size: .7rem; font-weight: 600;
    }
    .kd-value { padding: 3px 8px; font-weight: 700; color: var(--text); }

    /* ── Expand bar ── */
    .expand-bar {
      padding: 7px 16px; cursor: pointer;
      font-size: .78rem; color: var(--accent);
      display: flex; align-items: center; gap: 5px;
      border-top: 1px solid var(--border);
      background: var(--bg2); user-select: none;
      transition: background .15s;
    }
    .expand-bar:hover { background: var(--card-hover); }
    .expand-icon { transition: transform .2s; display: inline-block; font-size: .7rem; }
    .card.open .expand-bar .expand-icon { transform: rotate(90deg); }
    .expand-label-open { display: none; }
    .card.open .expand-label { display: none; }
    .card.open .expand-label-open { display: inline; }

    /* ── Card detail (expandable) ── */
    .card-detail { display: none; border-top: 1px solid var(--border); }
    .card.open .card-detail { display: block; }

    .detail-section {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
    }
    .detail-section:last-child { border-bottom: none; }
    .detail-label {
      font-size: .75rem; font-weight: 700; color: var(--text2);
      letter-spacing: .3px; margin-bottom: 8px;
    }
    .detail-text {
      font-size: .88rem; color: var(--text); line-height: 1.65;
    }

    /* ── Market view ── */
    .mv-grid { display: flex; flex-direction: column; gap: 6px; }
    .mv-row { display: grid; grid-template-columns: 80px 1fr; gap: 8px; align-items: baseline; }
    .mv-key {
      font-size: .72rem; font-weight: 700; color: var(--text2);
      white-space: nowrap; padding-top: 2px;
    }

    /* ── Scenarios ── */
    .scenario-grid {
      display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;
    }
    @media (max-width: 580px) { .scenario-grid { grid-template-columns: 1fr; } }
    .scenario-cell {
      border-radius: 8px; padding: 10px 12px;
      border: 1px solid var(--border); font-size: .83rem; line-height: 1.5;
    }
    .scenario-cell.base { border-color: var(--accent); background: rgba(88,166,255,.06); }
    .scenario-cell.bull { border-color: var(--green); background: rgba(63,185,80,.06); }
    .scenario-cell.bear { border-color: var(--red); background: rgba(248,81,73,.06); }
    .sc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .sc-label { font-size: .7rem; font-weight: 700; }
    .scenario-cell.base .sc-label { color: var(--accent); }
    .scenario-cell.bull .sc-label { color: var(--green); }
    .scenario-cell.bear .sc-label { color: var(--red); }
    .sc-prob-text { font-size: .7rem; font-weight: 700; color: var(--text2); }
    .sc-prob-bar {
      height: 3px; background: var(--bg4); border-radius: 2px; margin-bottom: 7px;
    }
    .sc-prob-fill { height: 100%; border-radius: 2px; }
    .scenario-cell.base .sc-prob-fill { background: var(--accent); }
    .scenario-cell.bull .sc-prob-fill { background: var(--green); }
    .scenario-cell.bear .sc-prob-fill { background: var(--red); }

    /* ── Investment angle tabs ── */
    .inv-angle { }
    .inv-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
    .inv-tab {
      padding: 5px 12px; border-radius: 14px; font-size: .78rem; font-weight: 600;
      cursor: pointer; border: 1px solid var(--border); background: var(--bg3);
      color: var(--text2); min-height: 32px; transition: all .15s;
    }
    .inv-tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .inv-panel { display: none; }
    .inv-panel.active { display: block; }

    /* Watch list */
    .watch-list { padding-left: 0; list-style: none; }
    .watch-list li {
      padding: 4px 0 4px 16px; position: relative; font-size: .88rem;
    }
    .watch-list li::before {
      content: '→'; position: absolute; left: 0; color: var(--text2);
    }

    /* Historical analog */
    .analog-text { color: var(--text2); font-style: italic; }

    /* Card footer */
    .card-footer {
      padding: 8px 16px;
      font-size: 0.76rem; color: var(--text2);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 4px;
      background: var(--bg3);
    }
    .card-footer-simple {
      padding: 8px 16px; border-top: 1px solid var(--border);
      font-size: 0.76rem; color: var(--text2);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 4px;
    }

    /* ══════════════════════════════════════
       card-v2 デザインシステム (Bloomberg級)
    ══════════════════════════════════════ */

    /* ── カード本体 ── */
    .card-v2 {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      margin-bottom: 12px;
      overflow: hidden;
      transition: border-color 200ms cubic-bezier(0.4, 0, 0.2, 1),
                  background 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-v2:hover {
      border-color: var(--border-default);
      background: var(--bg-card-hover);
    }
    .card-v2[data-importance="5"] { border-left: 3px solid var(--importance-5); }
    .card-v2[data-importance="4"] { border-left: 3px solid var(--importance-4); }
    .card-v2[data-owned="true"] { border-left: 3px solid var(--bullish); }
    .card-v2.hidden-by-filter, .card-v2.hidden-by-cat { display: none; }
    .pf-owned-badge {
      background: rgba(0,200,83,0.15);
      color: var(--bullish);
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 700;
      letter-spacing: 0.02em;
      flex-shrink: 0;
    }

    /* ── ヘッダー ── */
    .card-v2__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-subtle);
      gap: 12px;
    }
    .card-v2__meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      min-width: 0;
    }

    /* ── 重要度インジケータ (バー5本+スコア) ── */
    .imp-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 8px;
      background: var(--bg-elevated);
      border-radius: 4px;
      cursor: pointer;
      transition: background 200ms cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid transparent;
      flex-shrink: 0;
    }
    .imp-indicator:hover {
      background: var(--border-subtle);
      border-color: var(--border-default);
    }
    .imp-indicator__bars {
      display: inline-flex;
      gap: 2px;
    }
    .imp-indicator__bar {
      width: 3px;
      height: 12px;
      background: var(--border-default);
      border-radius: 1px;
      transition: background 200ms;
    }
    .imp-indicator--5 .imp-indicator__bar.is-active { background: var(--importance-5); }
    .imp-indicator--4 .imp-indicator__bar.is-active { background: var(--importance-4); }
    .imp-indicator--3 .imp-indicator__bar.is-active { background: var(--importance-3); }
    .imp-indicator--2 .imp-indicator__bar.is-active { background: var(--importance-2); }
    .imp-indicator--1 .imp-indicator__bar.is-active { background: var(--importance-1); }
    .imp-indicator__score {
      font-family: "SF Mono", "JetBrains Mono", "IBM Plex Mono", monospace;
      font-feature-settings: "tnum";
      font-size: 11px;
      font-weight: 500;
      color: var(--text-secondary);
      letter-spacing: -0.02em;
    }

    /* ── カテゴリ・影響チップ ── */
    .cat-chip, .impact-chip {
      font-size: 11px;
      font-weight: 500;
      padding: 4px 8px;
      border-radius: 4px;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .cat-chip {
      background: var(--neutral-bg);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .impact-chip--bullish { background: var(--bullish-bg); color: var(--bullish); }
    .impact-chip--bearish { background: var(--bearish-bg); color: var(--bearish); }
    .impact-chip--neutral { background: var(--neutral-bg); color: var(--neutral); }

    /* ── ブックマークボタン (SVG版) ── */
    .card-v2__header .bookmark-btn {
      background: transparent;
      border: none;
      color: var(--text-tertiary);
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
      transition: color 200ms;
      flex-shrink: 0;
      font-size: inherit;
    }
    .card-v2__header .bookmark-btn:hover { color: var(--action); transform: none; }
    .card-v2__header .bookmark-btn.bookmarked,
    .card-v2__header .bookmark-btn.is-active { color: var(--action); }
    .card-v2__header .bookmark-btn.bookmarked svg path,
    .card-v2__header .bookmark-btn.is-active svg path { fill: currentColor; }

    /* ── メインコンテンツ ── */
    .card-v2__main { padding: 16px; }
    .card-v2__title {
      font-family: "Inter", "SF Pro Text", -apple-system, "Hiragino Sans", sans-serif;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--text-primary);
      margin: 0 0 12px;
      letter-spacing: -0.01em;
    }
    @media (min-width: 768px) { .card-v2__title { font-size: 16px; } }

    /* ── データグリッド (Bloomberg風) ── */
    .data-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .data-cell {
      background: var(--bg-card);
      padding: 8px 12px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .data-cell__label {
      font-size: 11px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 500;
    }
    .data-cell__value {
      font-family: "SF Mono", "JetBrains Mono", "IBM Plex Mono", monospace;
      font-feature-settings: "tnum";
      font-size: 15px;
      font-weight: 500;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }
    .data-cell__value.is-positive { color: var(--bullish); }
    .data-cell__value.is-negative { color: var(--bearish); }
    @media (max-width: 480px) {
      .data-grid { grid-template-columns: repeat(2, 1fr); }
      .data-grid .data-cell:nth-child(3) { grid-column: span 2; }
      .data-cell__value { font-size: 14px; }
    }
    @media (min-width: 768px) { .data-cell__value { font-size: 16px; } }

    /* ── ポイントリスト (card-v2) ── */
    .card-v2__main .points-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .points-list__item {
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-secondary);
      padding-left: 16px;
      position: relative;
    }
    .points-list__item::before {
      content: "";
      position: absolute;
      left: 4px;
      top: 8px;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--action);
    }

    /* ── 内訳パネル ── */
    .breakdown-v2 {
      background: var(--bg-elevated);
      border-top: 1px solid var(--border-subtle);
      padding: 16px;
      animation: breakdown-in 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes breakdown-in {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .breakdown-v2__summary {
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-primary);
      padding: 12px;
      background: var(--bg-card);
      border-radius: 4px;
      border-left: 2px solid var(--action);
      margin-bottom: 16px;
    }
    .breakdown-v2__rows { display: flex; flex-direction: column; gap: 16px; }
    .bd-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
    .bd-row__head { display: flex; justify-content: space-between; align-items: center; }
    .bd-row__label {
      font-size: 11px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 500;
    }
    .bd-row__weight {
      font-family: "SF Mono", monospace;
      font-feature-settings: "tnum";
      font-size: 11px;
      color: var(--text-tertiary);
    }
    .bd-row__bar-wrap {
      height: 4px;
      background: var(--border-subtle);
      border-radius: 2px;
      overflow: hidden;
    }
    .bd-row__bar {
      height: 100%;
      width: 0;
      background: var(--bar-color, var(--action));
      border-radius: 2px;
      transition: width 400ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .bd-row__detail { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
    .bd-row__rationale {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .bd-row__na { color: var(--text-tertiary); font-style: italic; }
    .bd-final {
      margin-top: 12px; padding-top: 10px;
      border-top: 1px solid var(--border-subtle);
      color: var(--text-tertiary); font-size: 11px; text-align: right;
    }
    .bd-final strong { color: var(--action); font-family: "SF Mono", monospace; }
    .is-positive { color: var(--bullish) !important; font-weight: 500; }
    .is-negative { color: var(--bearish) !important; font-weight: 500; }

    /* ── フッター ── */
    .card-v2__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-card);
    }
    .card-v2__expand {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: none;
      color: var(--action);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      padding: 4px 0;
      transition: opacity 200ms;
    }
    .card-v2__expand:hover { opacity: 0.7; }
    .card-v2__expand-icon {
      transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-v2__expand[aria-expanded="true"] .card-v2__expand-icon {
      transform: rotate(180deg);
    }
    .card-v2__source { font-size: 11px; color: var(--text-tertiary); }

    /* ── 詳細セクション ── */
    .card-v2__details {
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-card);
      animation: breakdown-in 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ══════════════════════════════════════ */

    /* ── Category sections ── */
    .cat-section { margin-bottom: 18px; }
    .cat-section-header {
      display: flex; align-items: center; gap: 8px;
      cursor: pointer; padding: 8px 0; user-select: none;
    }
    .cat-section-title { font-size: .95rem; font-weight: 700; color: var(--text); }
    .cat-toggle { color: var(--text2); transition: transform .2s; font-size: .8rem; }
    .cat-section.collapsed .cat-toggle { transform: rotate(-90deg); }
    .cat-section.collapsed .cat-body { display: none; }
    .card.hidden-by-filter { display: none; }
    .card.hidden-by-cat { display: none; }
    .cat-section.all-hidden { display: none; }

    /* ── Bookmarks panel ── */
    #bookmarks-panel { margin-bottom: 20px; }
    .bookmarks-empty { color: var(--text2); font-size: .88rem; padding: 16px 0; }

    /* ── Preferences form ── */
    #tomorrow-preferences {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px; margin-top: 20px;
    }
    #tomorrow-preferences h2 { font-size: 1.0rem; color: var(--accent); margin-bottom: 6px; }
    #tomorrow-preferences > p { font-size: .86rem; color: var(--text2); margin-bottom: 16px; }
    .pref-group { margin-bottom: 16px; }
    .pref-label { font-size: .83rem; font-weight: 700; color: var(--text2); margin-bottom: 8px; display: block; }
    .cat-checkboxes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    @media (max-width: 480px) { .cat-checkboxes { grid-template-columns: 1fr; } }
    .cat-checkbox-item {
      display: flex; align-items: center; gap: 8px;
      background: var(--bg3); border: 2px solid var(--border);
      border-radius: 10px; padding: 10px 12px; cursor: pointer;
      min-height: 44px; font-size: .86rem; transition: all .15s; user-select: none;
    }
    .cat-checkbox-item:hover { border-color: var(--accent); }
    .cat-checkbox-item.selected { border-color: var(--accent); background: rgba(88,166,255,.08); color: var(--accent); }
    .cat-checkbox-item input[type=checkbox] { display: none; }
    .kw-input {
      width: 100%; padding: 10px 14px; border-radius: 10px;
      background: var(--bg3); border: 1px solid var(--border);
      color: var(--text); font-size: .9rem; font-family: inherit; min-height: 44px;
    }
    .kw-input:focus { outline: none; border-color: var(--accent); }
    .count-options { display: flex; gap: 8px; flex-wrap: wrap; }
    .count-option {
      padding: 8px 18px; border-radius: 20px; border: 2px solid var(--border);
      background: var(--bg3); color: var(--text2); cursor: pointer;
      font-size: .86rem; min-height: 44px; display: flex; align-items: center;
      transition: all .15s; font-weight: 600; user-select: none;
    }
    .count-option.selected { border-color: var(--accent); color: var(--accent); background: rgba(88,166,255,.08); }
    .pref-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
    .pref-note { font-size: .75rem; color: var(--text2); margin-top: 10px; line-height: 1.5; }
    .pref-status {
      font-size: .85rem; margin-top: 10px; padding: 10px 14px;
      border-radius: 8px; display: none; line-height: 1.5;
    }
    .pref-status.success { background: rgba(63,185,80,.12); color: var(--green); display: block; }
    .pref-status.error { background: rgba(248,81,73,.12); color: var(--red); display: block; }
    .pref-status.loading { background: rgba(88,166,255,.08); color: var(--accent); display: block; }
    .pref-status a { color: inherit; text-decoration: underline; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      display: inline-block; width: 13px; height: 13px;
      border: 2px solid var(--border); border-top-color: var(--accent);
      border-radius: 50%; animation: spin .6s linear infinite;
      vertical-align: middle; margin-right: 5px;
    }
    .debug-toggle-link {
      font-size: .75rem; color: var(--text2); cursor: pointer;
      margin-top: 10px; display: inline-block;
    }
    .debug-toggle-link:hover { color: var(--accent); }
    .debug-panel {
      margin-top: 8px; background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 12px 14px; font-size: .75rem;
      font-family: 'SF Mono', 'Consolas', monospace; color: var(--text2); display: none;
    }
    .debug-panel.open { display: block; }
    .debug-row { margin-bottom: 5px; word-break: break-all; }
    .debug-key { color: var(--accent); margin-right: 6px; }

    /* ── Footer ── */
    footer {
      text-align: center; color: var(--text2); font-size: 0.8rem;
      margin-top: 40px; padding: 20px 16px;
      border-top: 1px solid var(--border);
    }
    .disclaimer {
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 12px 14px; margin-bottom: 14px;
      text-align: left; font-size: .82rem; line-height: 1.6;
    }

    /* ── Scroll to top ── */
    #scroll-top {
      position: fixed; bottom: 24px; right: 20px; z-index: 200;
      background: var(--accent); color: #fff;
      border: none; border-radius: 50%; width: 44px; height: 44px;
      font-size: 1.1rem; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.3);
      display: none; align-items: center; justify-content: center;
      transition: opacity .2s;
    }
    #scroll-top.visible { display: flex; }

    /* ── Glossary highlight ── */
    .gloss-hl {
      border-bottom: 1px dashed var(--accent); cursor: help;
      color: inherit; transition: background .1s;
    }
    .gloss-hl:hover { background: rgba(88,166,255,.12); border-radius: 2px; }
    .gloss-tooltip {
      position: fixed; background: var(--bg2); border: 1px solid var(--accent);
      border-radius: 8px; padding: 8px 12px; font-size: 0.8rem;
      max-width: 260px; z-index: 500; pointer-events: none;
      box-shadow: 0 4px 12px rgba(0,0,0,.3); line-height: 1.5;
      color: var(--text); display: none;
    }
    .gloss-tooltip-term { font-weight: 700; color: var(--accent); margin-bottom: 2px; }

    /* ── Market Hero Section ── */
    .market-hero {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px 22px; margin-bottom: 12px;
      overflow: hidden;
    }
    .market-hero-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 14px; gap: 10px; flex-wrap: wrap;
    }
    .market-hero-title {
      font-size: 0.9rem; font-weight: 700; color: var(--text2);
      display: flex; align-items: center; gap: 6px;
    }
    .market-hero-updated {
      font-size: 0.75rem; color: var(--text3);
    }
    .market-price-row {
      display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .market-current {
      font-size: 2.6rem; font-weight: 800; line-height: 1.1;
      font-variant-numeric: tabular-nums; letter-spacing: -0.5px;
      color: var(--text);
    }
    .market-change {
      font-size: 1.1rem; font-weight: 700; font-variant-numeric: tabular-nums;
      display: flex; align-items: center; gap: 4px;
    }
    .market-change.up { color: #22c55e; }
    .market-change.down { color: #ef4444; }
    .market-change.flat { color: var(--text2); }
    .market-sub-row {
      display: flex; flex-wrap: wrap; gap: 6px 20px;
      font-size: 0.8rem; color: var(--text2); margin-bottom: 14px;
    }
    .market-sub-item { white-space: nowrap; }
    .market-sub-label { color: var(--text3); }

    /* Index selector tabs */
    .index-selector {
      display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap;
    }
    .idx-sel-btn {
      padding: 7px 18px; border-radius: 8px; border: 1px solid var(--border);
      font-size: 0.85rem; font-weight: 600; cursor: pointer;
      background: var(--bg3); color: var(--text2); transition: all 0.15s;
    }
    .idx-sel-btn.active {
      background: var(--accent); color: #fff; border-color: var(--accent);
    }

    /* Period tabs */
    .chart-period-tabs {
      display: flex; gap: 4px; margin-bottom: 10px; flex-wrap: wrap;
    }
    .chart-period-btn {
      padding: 4px 12px; border-radius: 10px; font-size: 0.78rem;
      font-weight: 600; cursor: pointer; border: 1px solid var(--border);
      background: var(--bg3); color: var(--text2); min-height: 30px;
      transition: all .15s;
    }
    .chart-period-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* Chart container */
    .chart-container {
      width: 100%; height: 320px; border-radius: 8px; overflow: hidden;
    }
    @media (max-width: 480px) {
      .chart-container { height: 220px; }
      .market-current { font-size: 2rem; }
    }
    @media (min-width: 700px) {
      .chart-container { height: 380px; }
    }

    /* 52-week range */
    .market-range-row {
      display: flex; flex-wrap: wrap; gap: 6px 20px;
      font-size: 0.79rem; color: var(--text2); margin-top: 12px; padding-top: 12px;
      border-top: 1px solid var(--border);
    }
    .market-range-item { white-space: nowrap; }
    .market-range-label { color: var(--text3); }
    .market-range-val { font-variant-numeric: tabular-nums; font-weight: 600; }
    .market-range-val.up { color: #22c55e; }
    .market-range-val.down { color: #ef4444; }

    /* ── Market History Section ── */
    .market-history {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px 20px; margin-bottom: 12px;
    }
    .market-history-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 12px; flex-wrap: wrap; gap: 8px;
    }
    .market-history-title {
      font-size: 0.95rem; font-weight: 700; color: var(--text);
    }
    .history-period-tabs {
      display: flex; gap: 4px; margin-bottom: 10px; flex-wrap: wrap;
    }
    .history-period-btn {
      padding: 4px 10px; border-radius: 10px; font-size: 0.76rem;
      font-weight: 600; cursor: pointer; border: 1px solid var(--border);
      background: var(--bg3); color: var(--text2); min-height: 28px;
      transition: all .15s;
    }
    .history-period-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .history-csv-btn {
      padding: 5px 12px; border-radius: 10px; font-size: 0.76rem;
      font-weight: 600; cursor: pointer; border: 1px solid var(--border);
      background: var(--bg3); color: var(--text2); min-height: 28px;
      transition: all .15s; text-decoration: none; display: inline-flex;
      align-items: center; gap: 4px;
    }
    .history-csv-btn:hover { background: var(--bg4); color: var(--text); text-decoration: none; }
    .history-table-wrap {
      overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 8px;
      border: 1px solid var(--border);
    }
    .history-table {
      width: 100%; border-collapse: collapse; font-size: 0.82rem;
      font-variant-numeric: tabular-nums;
    }
    .history-table th {
      background: var(--bg3); color: var(--text2); font-weight: 600;
      padding: 8px 12px; text-align: right; white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }
    .history-table th:first-child { text-align: left; }
    .history-table td {
      padding: 7px 12px; text-align: right; border-bottom: 1px solid var(--border);
      white-space: nowrap; color: var(--text);
    }
    .history-table td:first-child { text-align: left; color: var(--text2); }
    .history-table tr:last-child td { border-bottom: none; }
    .history-table tr:hover td { background: var(--card-hover); }
    .history-table td.up { color: #22c55e; }
    .history-table td.down { color: #ef4444; }
    @media (max-width: 540px) {
      .history-table .col-volume { display: none; }
    }

    /* ── Market Hero Two-Column Layout ── */
    .market-hero-body {
      display: grid;
      grid-template-columns: 1fr 310px;
      gap: 20px;
      align-items: start;
      margin-top: 4px;
    }
    .market-hero-left { min-width: 0; }
    .market-hero-right { min-width: 0; }
    @media (max-width: 900px) {
      .market-hero-body { grid-template-columns: 1fr; gap: 14px; }
    }
    @media (max-width: 480px) {
      .chart-container { height: 220px !important; }
      .market-hero { padding: 14px 14px; }
    }

    /* ── Insight Panel (AI洞察) ── */
    .insight-panel {
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 10px; padding: 14px 16px;
    }
    .insight-header {
      display: flex; align-items: center; gap: 7px;
      margin-bottom: 12px; padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .insight-icon { font-size: 0.95rem; flex-shrink: 0; }
    .insight-title {
      font-size: 0.8rem; font-weight: 700; color: var(--text2); flex: 1;
      letter-spacing: .2px;
    }
    .sentiment-badge {
      font-size: 0.65rem; font-weight: 700;
      padding: 2px 8px; border-radius: 10px; white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .sentiment-badge.sentiment-強気 {
      background: rgba(34,197,94,.14); color: #22c55e;
      border: 1px solid rgba(34,197,94,.35);
    }
    .sentiment-badge.sentiment-弱気 {
      background: rgba(239,68,68,.14); color: #ef4444;
      border: 1px solid rgba(239,68,68,.35);
    }
    .sentiment-badge.sentiment-中立 {
      background: rgba(139,148,158,.12); color: var(--text2);
      border: 1px solid var(--border);
    }
    .insight-driver {
      display: flex; align-items: flex-start; gap: 7px;
      margin-bottom: 10px;
    }
    .insight-driver-label {
      font-size: 0.62rem; font-weight: 700;
      background: var(--bg4); border: 1px solid var(--border);
      border-radius: 5px; padding: 2px 6px; color: var(--text3);
      white-space: nowrap; flex-shrink: 0; margin-top: 1px;
    }
    .insight-driver-text {
      font-size: 0.84rem; font-weight: 700; color: var(--text); line-height: 1.4;
    }
    .insight-body {
      font-size: 0.78rem; color: var(--text); line-height: 1.75;
      margin-bottom: 14px; max-height: 148px; overflow-y: auto;
      scrollbar-width: thin; scrollbar-color: var(--border) transparent;
    }
    .insight-body::-webkit-scrollbar { width: 3px; }
    .insight-body::-webkit-scrollbar-thumb {
      background: var(--border); border-radius: 2px;
    }
    .impact-map-title {
      font-size: 0.62rem; font-weight: 700; color: var(--text3);
      letter-spacing: .6px; text-transform: uppercase; margin-bottom: 8px;
    }
    .impact-row {
      display: flex; align-items: center; gap: 8px; margin-bottom: 5px;
    }
    .impact-bar-track {
      flex: 1; height: 4px; background: var(--bg4);
      border-radius: 2px; overflow: hidden; min-width: 30px;
    }
    .impact-bar-fill { height: 100%; border-radius: 2px; }
    .impact-row.positive .impact-bar-fill { background: #22c55e; }
    .impact-row.negative .impact-bar-fill { background: #ef4444; }
    .impact-row.neutral .impact-bar-fill { background: var(--text3); }
    .impact-label {
      font-size: 0.7rem; color: var(--text2);
      min-width: 90px; text-align: right; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    .impact-sign { font-weight: 800; margin-left: 3px; }
    .impact-row.positive .impact-sign { color: #22c55e; }
    .impact-row.negative .impact-sign { color: #ef4444; }
    .impact-row.neutral .impact-sign { color: var(--text3); }
    .insight-related {
      margin-top: 12px; padding-top: 10px;
      border-top: 1px solid var(--border);
    }
    .insight-related-label {
      font-size: 0.62rem; font-weight: 700; color: var(--text3);
      letter-spacing: .4px; text-transform: uppercase; margin-bottom: 5px;
    }
    .insight-related-link {
      display: block; font-size: 0.72rem; color: var(--accent);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 3px; line-height: 1.4;
    }
    .insight-related-link:hover { text-decoration: underline; }
    .insight-empty {
      text-align: center; color: var(--text2); font-size: 0.78rem;
      padding: 20px 0; line-height: 1.6;
    }

    /* ════════════════════════════════════════════
       DS (Daily Stats) 統計分析パネル
       ════════════════════════════════════════════ */
    .ds-panel {
      position: relative;
      margin-top: 20px;
      padding: 20px 22px;
      background: linear-gradient(135deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px;
      backdrop-filter: blur(20px);
      overflow: hidden;
    }
    .ds-panel::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(34,197,94,0.4), transparent);
    }
    .ds-panel__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }
    .ds-panel__header h3 {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: rgba(255,255,255,0.95);
      margin: 0;
    }
    .ds-panel__badge {
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 9px;
      background: rgba(255,255,255,0.06);
      border-radius: 999px;
      color: rgba(255,255,255,0.55);
      border: 1px solid rgba(255,255,255,0.07);
    }

    /* ── パーセンタイルバー ── */
    .ds-percentile { margin-bottom: 22px; }
    .ds-percentile__label {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 6px;
    }
    .ds-percentile__value {
      font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
      font-size: 28px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }
    .ds-percentile__value .unit {
      font-size: 12px;
      color: rgba(255,255,255,0.45);
      margin-left: 3px;
      font-weight: 400;
    }
    .ds-percentile__bar {
      position: relative;
      height: 7px;
      background: linear-gradient(90deg,
        rgba(239,68,68,0.45) 0%,
        rgba(245,158,11,0.3) 20%,
        rgba(34,197,94,0.35) 50%,
        rgba(245,158,11,0.3) 80%,
        rgba(239,68,68,0.45) 100%
      );
      border-radius: 4px;
      overflow: visible;
    }
    .ds-percentile__marker {
      position: absolute;
      top: -5px;
      width: 4px;
      height: 17px;
      background: #fff;
      border-radius: 2px;
      box-shadow: 0 0 10px rgba(255,255,255,0.65), 0 2px 4px rgba(0,0,0,0.3);
      transform: translateX(-50%);
      transition: left 1.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ds-percentile__caption {
      margin-top: 8px;
      font-size: 0.7rem;
      color: rgba(255,255,255,0.5);
    }

    /* ── KPI 4枚グリッド ── */
    .ds-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 22px;
    }
    .ds-kpi {
      padding: 12px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 9px;
      transition: transform 0.28s cubic-bezier(0.4,0,0.2,1),
                  border-color 0.28s,
                  background 0.28s;
      cursor: default;
    }
    .ds-kpi:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.04);
      border-color: rgba(34,197,94,0.22);
    }
    .ds-kpi__label {
      font-size: 0.58rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 5px;
    }
    .ds-kpi__value {
      font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
      font-size: 1.05rem;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      letter-spacing: -0.01em;
    }
    .ds-kpi__value .unit {
      font-size: 0.6rem;
      color: rgba(255,255,255,0.35);
      margin-left: 2px;
      font-weight: 400;
    }
    .ds-kpi[data-trend="up"] .ds-kpi__value { color: #22c55e; }
    .ds-kpi[data-trend="down"] .ds-kpi__value { color: #ef4444; }
    .ds-kpi__caption {
      margin-top: 3px;
      font-size: 0.58rem;
      color: rgba(255,255,255,0.35);
    }

    /* ── 類似日予測 ── */
    .ds-similar {
      padding: 14px;
      background: rgba(255,255,255,0.018);
      border-radius: 10px;
    }
    .ds-similar__title {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      color: rgba(255,255,255,0.65);
      margin-bottom: 10px;
    }
    .ds-similar__count {
      font-family: 'JetBrains Mono', 'SF Mono', monospace;
      color: rgba(255,255,255,0.38);
    }
    .ds-similar__forecast {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }
    .ds-forecast {
      padding: 10px;
      background: rgba(255,255,255,0.022);
      border-radius: 7px;
    }
    .ds-forecast__period {
      font-size: 0.6rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 4px;
    }
    .ds-forecast__value {
      font-family: 'JetBrains Mono', 'SF Mono', monospace;
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .ds-forecast__value[data-trend="up"] { color: #22c55e; }
    .ds-forecast__value[data-trend="down"] { color: #ef4444; }
    .ds-forecast__value[data-trend="neutral"] { color: rgba(255,255,255,0.7); }
    .ds-forecast__value .unit { font-size: 0.65rem; color: inherit; opacity: 0.7; margin-left: 1px; font-weight: 400; }
    .ds-forecast__bar {
      height: 3px;
      background: rgba(255,255,255,0.06);
      border-radius: 2px;
      overflow: hidden;
    }
    .ds-forecast__bar > div {
      height: 100%;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      border-radius: 2px;
      transform: scaleX(0);
      transform-origin: left;
      animation: ds-bar-fill 1.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      animation-delay: 0.4s;
    }
    .ds-forecast__bar.neg > div {
      background: linear-gradient(90deg, #ef4444, #dc2626);
    }
    .ds-forecast__win {
      margin-top: 5px;
      font-size: 0.6rem;
      color: rgba(255,255,255,0.4);
    }

    /* ── 詳細リスト ── */
    .ds-similar__detail summary {
      cursor: pointer;
      font-size: 0.7rem;
      color: #22c55e;
      user-select: none;
      padding: 7px 0;
      list-style: none;
    }
    .ds-similar__detail summary::-webkit-details-marker { display: none; }
    .ds-similar__detail summary::before {
      content: '▶';
      display: inline-block;
      margin-right: 5px;
      transition: transform 0.2s;
      font-size: 0.5rem;
      vertical-align: middle;
    }
    .ds-similar__detail[open] summary::before { transform: rotate(90deg); }
    .ds-similar__list {
      list-style: none;
      margin: 6px 0 0;
      padding: 0;
    }
    .ds-similar__list li {
      display: grid;
      grid-template-columns: auto 64px 1fr auto;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.68rem;
      align-items: center;
    }
    .ds-similar__list li:last-child { border-bottom: none; }
    .ds-similar__date {
      font-family: 'JetBrains Mono', 'SF Mono', monospace;
      color: rgba(255,255,255,0.65);
    }
    .ds-similar__change {
      font-family: 'JetBrains Mono', 'SF Mono', monospace;
      color: #ef4444;
      text-align: right;
    }
    .ds-similar__change.pos { color: #22c55e; }
    .ds-similar__context {
      color: rgba(255,255,255,0.45);
      font-size: 0.62rem;
    }
    .ds-similar__after {
      font-size: 0.62rem;
      color: rgba(255,255,255,0.55);
      text-align: right;
      white-space: nowrap;
    }
    .ds-similar__after strong { color: #22c55e; }
    .ds-similar__after strong.neg { color: #ef4444; }

    /* ── アラート ── */
    .ds-alert {
      position: relative;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      margin-top: 16px;
      border-radius: 14px;
      overflow: hidden;
      animation: ds-alert-enter 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ds-alert[data-level="warning"] {
      background: linear-gradient(135deg, rgba(245,158,11,0.16), rgba(245,158,11,0.05));
      border: 1px solid rgba(245,158,11,0.32);
    }
    .ds-alert[data-level="extreme"] {
      background: linear-gradient(135deg, rgba(239,68,68,0.19), rgba(239,68,68,0.06));
      border: 1px solid rgba(239,68,68,0.42);
    }
    .ds-alert__pulse {
      position: absolute;
      top: 50%;
      left: 26px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      transform: translateY(-50%);
    }
    .ds-alert[data-level="warning"] .ds-alert__pulse { background: #f59e0b; }
    .ds-alert[data-level="extreme"] .ds-alert__pulse { background: #ef4444; }
    .ds-alert__pulse::before,
    .ds-alert__pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: ds-pulse 2s cubic-bezier(0,0,0.2,1) infinite;
    }
    .ds-alert__pulse::after { animation-delay: 1s; }
    .ds-alert__icon { font-size: 1.5rem; margin-left: 20px; flex-shrink: 0; }
    .ds-alert__body { flex: 1; min-width: 0; }
    .ds-alert__title {
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 3px;
      color: rgba(255,255,255,0.95);
    }
    .ds-alert__desc {
      font-size: 0.77rem;
      color: rgba(255,255,255,0.82);
      margin-bottom: 3px;
    }
    .ds-alert__history { font-size: 0.65rem; color: rgba(255,255,255,0.5); }

    /* ── アニメーション ── */
    @keyframes ds-pulse {
      0% { transform: scale(1); opacity: 0.7; }
      100% { transform: scale(3.5); opacity: 0; }
    }
    @keyframes ds-alert-enter {
      from { opacity: 0; transform: translateY(-10px) scale(0.98); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes ds-bar-fill {
      to { transform: scaleX(1); }
    }
    @keyframes ds-counter-in {
      from { opacity: 0; transform: translateY(7px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .ds-percentile__value,
    .ds-kpi__value,
    .ds-forecast__value {
      animation: ds-counter-in 0.45s cubic-bezier(0.16,1,0.3,1) backwards;
    }
    .ds-kpi:nth-child(1) .ds-kpi__value { animation-delay: 0.05s; }
    .ds-kpi:nth-child(2) .ds-kpi__value { animation-delay: 0.10s; }
    .ds-kpi:nth-child(3) .ds-kpi__value { animation-delay: 0.15s; }
    .ds-kpi:nth-child(4) .ds-kpi__value { animation-delay: 0.20s; }

    /* ── DS スマホ ── */
    @media (max-width: 640px) {
      .ds-panel { padding: 14px 14px; }
      .ds-percentile__value { font-size: 22px; }
      .ds-kpi-grid { grid-template-columns: repeat(2, 1fr); }
      .ds-kpi__value { font-size: 0.9rem; }
      .ds-similar__forecast { grid-template-columns: 1fr; gap: 7px; }
      .ds-similar__list li { grid-template-columns: auto 55px; row-gap: 3px; }
      .ds-similar__context, .ds-similar__after { grid-column: 1 / -1; text-align: left; }
      .ds-alert { padding: 12px 13px; gap: 10px; }
      .ds-alert__icon { font-size: 1.2rem; margin-left: 18px; }
    }

    /* ── News Timeline ── */
    .news-timeline-section {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px 20px; margin-bottom: 12px;
    }
    .timeline-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 14px; flex-wrap: wrap; gap: 8px;
    }
    .timeline-title {
      font-size: 0.95rem; font-weight: 700; color: var(--text);
    }
    .timeline-filters { display: flex; gap: 4px; flex-wrap: wrap; }
    .tl-filter-btn {
      padding: 4px 10px; border-radius: 10px; font-size: 0.74rem;
      font-weight: 600; cursor: pointer; border: 1px solid var(--border);
      background: var(--bg3); color: var(--text2); min-height: 28px;
      transition: all .15s;
    }
    .tl-filter-btn:hover { background: var(--bg4); color: var(--text); }
    .tl-filter-btn.active {
      background: var(--accent); color: #fff; border-color: var(--accent);
    }
    /* Each timeline day */
    .timeline-entry { margin-bottom: 3px; }
    .timeline-day-header {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 12px; border-radius: 8px;
      background: var(--bg3); cursor: pointer;
      transition: background .12s; user-select: none;
    }
    .timeline-day-header:hover { background: var(--bg4); }
    .tl-bar {
      width: 3px; min-height: 26px; border-radius: 2px; flex-shrink: 0;
    }
    .tl-bar.up { background: #22c55e; }
    .tl-bar.down { background: #ef4444; }
    .tl-bar.flat { background: var(--text3); }
    .tl-date {
      font-size: 0.8rem; font-weight: 700; color: var(--text);
      min-width: 82px; font-variant-numeric: tabular-nums;
    }
    .tl-chg {
      font-size: 0.8rem; font-weight: 700;
      font-variant-numeric: tabular-nums; min-width: 72px;
    }
    .tl-chg.up { color: #22c55e; }
    .tl-chg.down { color: #ef4444; }
    .tl-chg.flat { color: var(--text3); }
    .tl-driver {
      font-size: 0.76rem; color: var(--text2); flex: 1;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .tl-toggle {
      color: var(--text3); font-size: 0.68rem; flex-shrink: 0;
      transition: transform .2s; display: inline-block;
    }
    .timeline-entry.open .tl-toggle { transform: rotate(90deg); }
    .tl-news-list {
      display: none; padding: 5px 0 8px 15px;
      border-left: 2px solid var(--bg4); margin-left: 14px;
    }
    .timeline-entry.open .tl-news-list { display: block; }
    .tl-news-item {
      display: flex; align-items: flex-start; gap: 7px;
      padding: 5px 8px; margin-bottom: 2px; border-radius: 6px;
      font-size: 0.77rem; transition: background .1s;
    }
    .tl-news-item:hover { background: var(--bg3); }
    .tl-news-badge {
      font-size: 0.6rem; font-weight: 700; padding: 2px 5px;
      border-radius: 5px; white-space: nowrap; flex-shrink: 0; margin-top: 1px;
    }
    .tl-news-badge.bullish {
      background: rgba(34,197,94,.13); color: #22c55e;
    }
    .tl-news-badge.bearish {
      background: rgba(239,68,68,.13); color: #ef4444;
    }
    .tl-news-badge.neutral {
      background: rgba(139,148,158,.12); color: var(--text2);
    }
    .tl-news-hl { color: var(--text); flex: 1; line-height: 1.4; }
    .tl-news-hl a { color: var(--text); }
    .tl-news-hl a:hover { color: var(--accent); text-decoration: underline; }
    .tl-empty {
      text-align: center; color: var(--text2); padding: 20px;
      font-size: 0.88rem;
    }
    @media (max-width: 540px) {
      .tl-driver { display: none; }
      .tl-date { min-width: 70px; }
    }

    /* ── PAT Modal ── */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.78); z-index: 999;
      align-items: center; justify-content: center;
    }
    .modal-box {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 14px;
      padding: 24px; max-width: 440px; width: 90%; margin: auto;
    }
    .modal-box h3 { color: var(--accent); margin-bottom: 10px; }
    .modal-box p { font-size: .87rem; color: var(--text2); margin-bottom: 14px; }
    .modal-actions { display: flex; gap: 8px; }
  </style>
</head>
<body class="font-m">

  <div class="container">
    <!-- Header -->
    <header>
      <div class="header-top">
        <div>
          <h1>📊 デイリーマーケットニュース</h1>
          <div class="meta">{{ date_str }} &nbsp;|&nbsp; 更新: {{ generated_at }} &nbsp;|&nbsp; {{ total_count }}本</div>
        </div>
        <div class="header-controls">
          <div class="font-btns">
            <button class="font-btn" id="font-s" onclick="setFont('s')" title="文字を小さく">A-</button>
            <button class="font-btn active" id="font-m" onclick="setFont('m')" title="標準">A</button>
            <button class="font-btn" id="font-l" onclick="setFont('l')" title="文字を大きく">A+</button>
          </div>
          <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" title="ダーク/ライト切り替え">🌙</button>
        </div>
      </div>
      <div class="header-actions">
        <a class="btn btn-primary" href="{{ base_url }}/feed.xml">📡 RSS</a>
        <a class="btn btn-secondary" href="{{ base_url }}/glossary.html">📚 用語集</a>
        <a class="btn btn-secondary" href="{{ base_url }}/analysis.html">📊 長期分析</a>
        <a class="btn btn-secondary" href="{{ base_url }}/preferences-history.html">🕓 設定履歴</a>
        <a class="btn btn-secondary" href="{{ base_url }}/portfolio.html">💼 ポートフォリオ</a>
        <button class="btn btn-bookmark" id="bookmark-tab-btn" onclick="toggleBookmarkPanel()">🔖 ブックマーク <span id="bookmark-count"></span></button>
      </div>
    </header>

    <!-- Index selector (日経 / S&P500) -->
    {% if market_data.nikkei or market_data.sp500 %}
    <div class="index-selector" id="index-selector">
      {% if market_data.nikkei %}
      <button class="idx-sel-btn active" data-idx="nikkei" onclick="switchHeroIndex(this,'nikkei')">📊 日経平均</button>
      {% endif %}
      {% if market_data.sp500 %}
      <button class="idx-sel-btn{% if not market_data.nikkei %} active{% endif %}" data-idx="sp500" onclick="switchHeroIndex(this,'sp500')">🇺🇸 S&amp;P 500</button>
      {% endif %}
    </div>
    {% endif %}

    <!-- Market Hero (日経平均チャート) -->
    {% if market_data.nikkei %}
    {% set nk = market_data.nikkei %}
    {% set nk_up = nk.change is not none and nk.change > 0 %}
    {% set nk_down = nk.change is not none and nk.change < 0 %}
    <div class="market-hero" id="market-nikkei">
      <div class="market-hero-header">
        <div class="market-hero-title">📊 {{ nk.name }}</div>
        {% if nk.updated_at %}
        <div class="market-hero-updated">最終更新 {{ nk.updated_at[:16] | replace('T', ' ') }} JST</div>
        {% endif %}
      </div>

      <div class="market-price-row">
        <div class="market-current" id="nk-current">
          {% if nk.current %}{{ "{:,.2f}".format(nk.current) }}{% else %}—{% endif %}
        </div>
        <div class="market-change {% if nk_up %}up{% elif nk_down %}down{% else %}flat{% endif %}">
          {% if nk_up %}▲{% elif nk_down %}▼{% else %}—{% endif %}
          {% if nk.change is not none %}{{ "{:,.2f}".format(nk.change | abs) }}{% endif %}
          {% if nk.change_percent is not none %}({{ "{:+.2f}".format(nk.change_percent) }}%){% endif %}
        </div>
      </div>

      <div class="market-sub-row">
        {% if nk.previous_close %}<span class="market-sub-item"><span class="market-sub-label">前日終値 </span>{{ "{:,.2f}".format(nk.previous_close) }}</span>{% endif %}
        {% if nk.open %}<span class="market-sub-item"><span class="market-sub-label">始値 </span>{{ "{:,.2f}".format(nk.open) }}</span>{% endif %}
        {% if nk.day_high %}<span class="market-sub-item"><span class="market-sub-label">高値 </span>{{ "{:,.2f}".format(nk.day_high) }}</span>{% endif %}
        {% if nk.day_low %}<span class="market-sub-item"><span class="market-sub-label">安値 </span>{{ "{:,.2f}".format(nk.day_low) }}</span>{% endif %}
      </div>

      <!-- Two-column body: Left=Chart / Right=AI Insight -->
      <div class="market-hero-body">

        <!-- Left: Period tabs + Chart + 52-week range -->
        <div class="market-hero-left">
          <div class="chart-period-tabs">
            <button class="chart-period-btn active" data-days="30" onclick="setChartPeriod(this, 30)">1M</button>
            <button class="chart-period-btn" data-days="90" onclick="setChartPeriod(this, 90)">3M</button>
            <button class="chart-period-btn" data-days="180" onclick="setChartPeriod(this, 180)">6M</button>
            <button class="chart-period-btn" data-days="365" onclick="setChartPeriod(this, 365)">1Y</button>
          </div>

          <div class="chart-container" id="nikkei-chart"></div>

          <div class="market-range-row">
            {% if nk.year_high %}
            <span class="market-range-item">
              <span class="market-range-label">年初来高値 </span>
              <span class="market-range-val up">{{ "{:,.2f}".format(nk.year_high) }}</span>
              {% if nk.year_high_date %}<span style="color:var(--text3)"> ({{ nk.year_high_date }})</span>{% endif %}
            </span>
            {% endif %}
            {% if nk.year_low %}
            <span class="market-range-item">
              <span class="market-range-label">年初来安値 </span>
              <span class="market-range-val down">{{ "{:,.2f}".format(nk.year_low) }}</span>
              {% if nk.year_low_date %}<span style="color:var(--text3)"> ({{ nk.year_low_date }})</span>{% endif %}
            </span>
            {% endif %}
          </div>
        </div><!-- /market-hero-left -->

        <!-- Right: AI Insight Panel -->
        <div class="market-hero-right">
          <div class="insight-panel">
            {% if insight and insight.primary_driver %}
            <div class="insight-header">
              <span class="insight-icon">🧠</span>
              <span class="insight-title">今日の動きの背景</span>
              {% if insight.sentiment %}
              <span class="sentiment-badge sentiment-{{ insight.sentiment }}">{{ insight.sentiment }}</span>
              {% endif %}
            </div>

            <div class="insight-driver">
              <span class="insight-driver-label">主因</span>
              <span class="insight-driver-text">{{ insight.primary_driver }}</span>
            </div>

            {% if insight.insight %}
            <div class="insight-body">{{ insight.insight }}</div>
            {% endif %}

            {% if insight.key_factors %}
            <div class="impact-map-title">影響度マップ</div>
            {% for kf in insight.key_factors %}
            {% set w_pct = ((kf.weight | default(0.5)) * 100) | int %}
            {% set dir_cls = 'positive' if kf.impact == '+' else ('negative' if kf.impact == '-' else 'neutral') %}
            <div class="impact-row {{ dir_cls }}">
              <div class="impact-bar-track">
                <div class="impact-bar-fill" style="width:{{ w_pct }}%"></div>
              </div>
              <span class="impact-label">
                {{ kf.factor | default('') }}<span class="impact-sign">{{ kf.impact | default('0') }}</span>
              </span>
            </div>
            {% endfor %}
            {% endif %}

            {% if insight.related_news_indices is defined and insight.related_news_indices %}
            <div class="insight-related">
              <div class="insight-related-label">関連ニュース</div>
              {# top_news は featured articles から近似して表示 #}
              {% set featured_top = featured[:10] %}
              {% for idx in insight.related_news_indices[:3] %}
              {% if idx < featured_top | length %}
              {% set art = featured_top[idx] %}
              <a class="insight-related-link"
                 href="{{ art.link | default('#') }}" target="_blank" rel="noopener">
                {{ art.impact_emoji | default('➡️') }} {{ art.headline | default(art.title) | truncate(42, true, '…') }}
              </a>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}

            {% else %}
            <div class="insight-empty">
              🧠 今日の動きの背景<br>
              <span style="font-size:0.72rem;margin-top:6px;display:block;color:var(--text3)">
                AI洞察は毎日の実行時に生成されます
              </span>
            </div>
            {% endif %}
          </div><!-- /insight-panel -->
        </div><!-- /market-hero-right -->

      </div><!-- /market-hero-body -->

      {# ── 統計分析パネル ───────────────────────────────────── #}
      {% if daily_stats %}
      {% set ds = daily_stats %}
      {% set sim = ds.similar_days %}

      {# アラート (±2σ超え) #}
      {% if ds.is_anomaly %}
      <div class="ds-alert" data-level="{{ ds.anomaly_level }}">
        <div class="ds-alert__pulse"></div>
        <div class="ds-alert__icon">{% if ds.anomaly_level == 'extreme' %}🚨{% else %}⚠️{% endif %}</div>
        <div class="ds-alert__body">
          <div class="ds-alert__title">本日は異常変動を検知</div>
          <div class="ds-alert__desc">
            <strong>{{ "{:+.2f}".format(ds.change_pct) }}%</strong> は過去30年で
            <strong>{{ ds.percentile_str }}</strong>
            ({{ "{:+.1f}".format(ds.sigma) }}σ{% if ds.anomaly_level == 'extreme' %}・極めて稀{% else %}・稀{% endif %})
          </div>
          <div class="ds-alert__history">
            過去30年で同等以上の変動: <strong>{{ ds.extreme_count }}日</strong> / {{ ds.total_days }}日中
          </div>
        </div>
      </div>
      {% endif %}

      {# メイン統計パネル #}
      <div class="ds-panel" data-anomaly="{{ ds.anomaly_level }}">
        <header class="ds-panel__header">
          <h3>📊 統計分析</h3>
          <span class="ds-panel__badge">過去30年比較</span>
        </header>

        {# パーセンタイルバー #}
        <div class="ds-percentile">
          <div class="ds-percentile__label">変動率パーセンタイル</div>
          <div class="ds-percentile__value">
            <span data-counter="{{ ds.percentile }}" data-decimals="1">{{ "{:.1f}".format(ds.percentile) }}</span><span class="unit">%ile</span>
          </div>
          <div class="ds-percentile__bar">
            <div class="ds-percentile__marker" style="left:{{ ds.percentile }}%"></div>
          </div>
          <div class="ds-percentile__caption">
            {% if ds.percentile >= 75 %}上位{{ "{:.0f}".format(100 - ds.percentile) }}%・やや高い変動
            {% elif ds.percentile <= 25 %}下位{{ "{:.0f}".format(ds.percentile) }}%・やや低い変動
            {% else %}中央値付近・平常範囲
            {% endif %}
          </div>
        </div>

        {# 4 KPI カード #}
        {% set sigma_trend = 'up' if ds.sigma > 0.5 else ('down' if ds.sigma < -0.5 else 'neutral') %}
        {% set vol_trend = 'up' if ds.volume_ratio >= 100 else 'down' %}
        {% set high_trend = 'up' if ds.from_high_pct >= 0 else 'down' %}
        {% set low_trend = 'up' if ds.from_low_pct >= 0 else 'down' %}
        <div class="ds-kpi-grid">
          <div class="ds-kpi" data-trend="{{ sigma_trend }}">
            <div class="ds-kpi__label">標準偏差</div>
            <div class="ds-kpi__value">
              <span data-counter="{{ ds.sigma }}" data-decimals="2" data-prefix="{{ '+' if ds.sigma > 0 else '' }}">{{ "{:+.2f}".format(ds.sigma) }}</span><span class="unit">σ</span>
            </div>
          </div>
          <div class="ds-kpi" data-trend="{{ vol_trend }}">
            <div class="ds-kpi__label">出来高比</div>
            <div class="ds-kpi__value">
              <span data-counter="{{ ds.volume_ratio }}" data-decimals="0">{{ "{:.0f}".format(ds.volume_ratio) }}</span><span class="unit">%</span>
            </div>
            <div class="ds-kpi__caption">30日平均比</div>
          </div>
          <div class="ds-kpi" data-trend="{{ high_trend }}">
            <div class="ds-kpi__label">年高比</div>
            <div class="ds-kpi__value">
              <span data-counter="{{ ds.from_high_pct }}" data-decimals="2" data-prefix="{{ '+' if ds.from_high_pct > 0 else '' }}">{{ "{:+.2f}".format(ds.from_high_pct) }}</span><span class="unit">%</span>
            </div>
            <div class="ds-kpi__caption">年初来高値比</div>
          </div>
          <div class="ds-kpi" data-trend="{{ low_trend }}">
            <div class="ds-kpi__label">年安比</div>
            <div class="ds-kpi__value">
              <span data-counter="{{ ds.from_low_pct }}" data-decimals="2" data-prefix="{{ '+' if ds.from_low_pct > 0 else '' }}">{{ "{:+.2f}".format(ds.from_low_pct) }}</span><span class="unit">%</span>
            </div>
            <div class="ds-kpi__caption">年初来安値比</div>
          </div>
        </div>

        {# 類似日分析 #}
        {% if sim and sim.sample_size > 0 %}
        <div class="ds-similar">
          <div class="ds-similar__title">
            <span>過去の類似日 ({{ sim.range }})</span>
            <span class="ds-similar__count">N={{ "{:,}".format(sim.sample_size) }}</span>
          </div>

          <div class="ds-similar__forecast">
            {# 5日後 #}
            {% if sim.return_5d is not none %}
            {% set t5 = 'up' if sim.return_5d >= 0 else 'down' %}
            {% set w5 = [[(sim.return_5d | abs * 6) | int, 100] | min, 3] | max %}
            <div class="ds-forecast">
              <div class="ds-forecast__period">5日後</div>
              <div class="ds-forecast__value" data-trend="{{ t5 }}">
                {{ "{:+.2f}".format(sim.return_5d) }}<span class="unit">%</span>
              </div>
              <div class="ds-forecast__bar {% if t5 == 'down' %}neg{% endif %}">
                <div style="width:{{ w5 }}%"></div>
              </div>
            </div>
            {% endif %}

            {# 30日後 #}
            {% if sim.return_30d is not none %}
            {% set t30 = 'up' if sim.return_30d >= 0 else 'down' %}
            {% set w30 = [[(sim.return_30d | abs * 6) | int, 100] | min, 3] | max %}
            <div class="ds-forecast">
              <div class="ds-forecast__period">30日後</div>
              <div class="ds-forecast__value" data-trend="{{ t30 }}">
                {{ "{:+.2f}".format(sim.return_30d) }}<span class="unit">%</span>
              </div>
              <div class="ds-forecast__bar {% if t30 == 'down' %}neg{% endif %}">
                <div style="width:{{ w30 }}%"></div>
              </div>
              {% if sim.win_rate_30d is not none %}
              <div class="ds-forecast__win">勝率 {{ "{:.1f}".format(sim.win_rate_30d) }}%</div>
              {% endif %}
            </div>
            {% endif %}

            {# 90日後 #}
            {% if sim.return_90d is not none %}
            {% set t90 = 'up' if sim.return_90d >= 0 else 'down' %}
            {% set w90 = [[(sim.return_90d | abs * 4) | int, 100] | min, 3] | max %}
            <div class="ds-forecast">
              <div class="ds-forecast__period">90日後</div>
              <div class="ds-forecast__value" data-trend="{{ t90 }}">
                {{ "{:+.2f}".format(sim.return_90d) }}<span class="unit">%</span>
              </div>
              <div class="ds-forecast__bar {% if t90 == 'down' %}neg{% endif %}">
                <div style="width:{{ w90 }}%"></div>
              </div>
            </div>
            {% endif %}
          </div><!-- /ds-similar__forecast -->

          {# 具体的な類似日 #}
          {% if sim.top_examples %}
          <details class="ds-similar__detail">
            <summary>具体的な類似日を見る</summary>
            <ul class="ds-similar__list">
              {% for ex in sim.top_examples %}
              <li>
                <div class="ds-similar__date">{{ ex.date }}</div>
                <div class="ds-similar__change {% if ex.change >= 0 %}pos{% endif %}">{{ "{:+.2f}".format(ex.change) }}%</div>
                <div class="ds-similar__context">{{ ex.context if ex.context else '—' }}</div>
                <div class="ds-similar__after">
                  30日後
                  {% if ex.return_30d is not none %}
                  <strong {% if ex.return_30d < 0 %}class="neg"{% endif %}>{{ "{:+.1f}".format(ex.return_30d) }}%</strong>
                  {% else %}—{% endif %}
                  {% if ex.return_90d is not none %}
                  / 90日後 <strong {% if ex.return_90d < 0 %}class="neg"{% endif %}>{{ "{:+.1f}".format(ex.return_90d) }}%</strong>
                  {% endif %}
                </div>
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endif %}

        </div><!-- /ds-similar -->
        {% endif %}
      </div><!-- /ds-panel -->
      {% endif %}
      {# ─────────────────────────────────────────────────────── #}

    </div>
    {% endif %}

    <!-- Market Hero (S&P 500チャート) -->
    {% if market_data.sp500 %}
    {% set sp = market_data.sp500 %}
    {% set sp_up = sp.change is not none and sp.change > 0 %}
    {% set sp_down = sp.change is not none and sp.change < 0 %}
    <div class="market-hero" id="market-sp500" style="display:none">
      <div class="market-hero-header">
        <div class="market-hero-title">🇺🇸 {{ sp.name }}</div>
        {% if sp.updated_at %}
        <div class="market-hero-updated">最終更新 {{ sp.updated_at[:16] | replace('T', ' ') }} JST</div>
        {% endif %}
      </div>

      <div class="market-price-row">
        <div class="market-current">
          {% if sp.current %}{{ "{:,.2f}".format(sp.current) }}{% else %}—{% endif %}
        </div>
        <div class="market-change {% if sp_up %}up{% elif sp_down %}down{% else %}flat{% endif %}">
          {% if sp_up %}▲{% elif sp_down %}▼{% else %}—{% endif %}
          {% if sp.change is not none %}{{ "{:,.2f}".format(sp.change | abs) }}{% endif %}
