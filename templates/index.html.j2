  <!-- Lightweight Charts (TradingView, Apache 2.0) -->
  <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>

  <!-- Market data embedded JSON -->
  <script type="application/json" id="market-data-json">{{ market_data_json | safe }}</script>

  <!-- News markers for chart -->
  <script type="application/json" id="news-markers-json">{{ news_markers_json | safe }}</script>

  <!-- News timeline data -->
  <script type="application/json" id="news-timeline-json">{{ news_timeline_json | safe }}</script>

  <script>
    // ── Market Chart & History ──
    (function() {
      const raw = document.getElementById('market-data-json');
      if (!raw) return;
      let MARKET;
      try { MARKET = JSON.parse(raw.textContent); } catch(e) { return; }
      const nk = MARKET.nikkei;
      if (!nk || !nk.ohlc || !nk.ohlc.length) return;

      // ── Helpers ──
      function fmtNum(v, decimals=2) {
        if (v == null) return '—';
        return Number(v).toLocaleString('ja-JP', {minimumFractionDigits: decimals, maximumFractionDigits: decimals});
      }
      function fmtVol(v) {
        if (v == null || v === 0) return '—';
        const n = Number(v);
        if (n >= 1e8) return (n / 1e8).toFixed(1) + '億';
        if (n >= 1e4) return (n / 1e4).toFixed(0) + '万';
        return n.toLocaleString('ja-JP');
      }
      function cutoffDate(days) {
        if (!days) return null;
        const d = new Date();
        d.setDate(d.getDate() - days);
        return d.toISOString().slice(0, 10);
      }

      // ── Chart ──
      const isDark = () =>
        (document.body.getAttribute('data-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';

      function chartColors() {
        return isDark()
          ? { bg: 'transparent', text: '#8b949e', grid: '#30363d', border: '#30363d', up: '#22c55e', down: '#ef4444' }
          : { bg: '#ffffff', text: '#656d76', grid: '#e5e7eb', border: '#d0d7de', up: '#16a34a', down: '#dc2626' };
      }

      let _chart = null, _candleSeries = null, _volSeries = null;
      let _ma5Series = null, _ma25Series = null, _ma75Series = null;
      let _currentDays = 30;

      // ── News markers (loaded from embedded JSON) ──
      let _newsMarkers = [];
      (function() {
        const el = document.getElementById('news-markers-json');
        if (!el) return;
        try { _newsMarkers = JSON.parse(el.textContent) || []; } catch(e) {}
      })();

      function initChart() {
        const container = document.getElementById('nikkei-chart');
        if (!container || typeof LightweightCharts === 'undefined') return;

        const c = chartColors();
        _chart = LightweightCharts.createChart(container, {
          layout: { background: { type: 'solid', color: c.bg }, textColor: c.text },
          grid: { vertLines: { color: c.grid }, horzLines: { color: c.grid } },
          crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
          rightPriceScale: { borderColor: c.border },
          timeScale: { borderColor: c.border, timeVisible: true },
          handleScroll: true,
          handleScale: true,
        });

        // Volume pane (bottom sub-chart)
        _volSeries = _chart.addHistogramSeries({
          color: 'rgba(100,149,237,0.4)',
          priceFormat: { type: 'volume' },
          priceScaleId: 'volume',
          scaleMargins: { top: 0.8, bottom: 0 },
        });

        // Candles
        _candleSeries = _chart.addCandlestickSeries({
          upColor: c.up, downColor: c.down,
          borderUpColor: c.up, borderDownColor: c.down,
          wickUpColor: c.up, wickDownColor: c.down,
          priceScaleId: 'right',
          scaleMargins: { top: 0.05, bottom: 0.25 },
        });

        // MA lines
        _ma5Series  = _chart.addLineSeries({ color: '#f59e0b', lineWidth: 1, title: 'MA5',  priceScaleId: 'right', crosshairMarkerVisible: false, lastValueVisible: false });
        _ma25Series = _chart.addLineSeries({ color: '#3b82f6', lineWidth: 1, title: 'MA25', priceScaleId: 'right', crosshairMarkerVisible: false, lastValueVisible: false });
        _ma75Series = _chart.addLineSeries({ color: '#a855f7', lineWidth: 1, title: 'MA75', priceScaleId: 'right', crosshairMarkerVisible: false, lastValueVisible: false });

        renderChartData(_currentDays);

        // Chart click → scroll to timeline day
        _chart.subscribeClick(function(param) {
          if (!param.time) return;
          const entry = document.querySelector(
            `.timeline-entry[data-date="${param.time}"]`
          );
          if (entry) {
            entry.scrollIntoView({ behavior: 'smooth', block: 'start' });
            if (!entry.classList.contains('open')) {
              entry.classList.add('open');
            }
          }
        });

        // Resize
        const ro = new ResizeObserver(() => {
          if (_chart) _chart.applyOptions({ width: container.clientWidth });
        });
        ro.observe(container);
      }

      function renderChartData(days) {
        if (!_chart) return;
        const cutoff = cutoffDate(days);
        const filtered = cutoff ? nk.ohlc.filter(r => r.date >= cutoff) : nk.ohlc;

        const candles = filtered.map(r => ({
          time: r.date,
          open: r.open, high: r.high, low: r.low, close: r.close,
        }));
        const vols = filtered.map(r => ({
          time: r.date,
          value: r.volume || 0,
          color: (r.close >= r.open) ? 'rgba(34,197,94,0.4)' : 'rgba(239,68,68,0.4)',
        }));

        // MA lines (align indices to filtered ohlc)
        function buildMa(maArr, field) {
          const out = [];
          nk.ohlc.forEach((r, i) => {
            if (cutoff && r.date < cutoff) return;
            const v = maArr[i];
            if (v != null) out.push({ time: r.date, value: v });
          });
          return out;
        }

        _candleSeries.setData(candles);
        _volSeries.setData(vols);
        _ma5Series.setData(buildMa(nk.ma5 || [], 'ma5'));
        _ma25Series.setData(buildMa(nk.ma25 || [], 'ma25'));
        _ma75Series.setData(buildMa(nk.ma75 || [], 'ma75'));

        // ── News markers ──
        if (_newsMarkers.length && _candleSeries) {
          const cutoffStr = cutoff || '1900-01-01';
          const markers = _newsMarkers
            .filter(m => m.date >= cutoffStr)
            .sort((a, b) => a.date < b.date ? -1 : 1)
            .map(m => {
              const isBull = m.impact === '強気';
              const isBear = m.impact === '弱気';
              return {
                time: m.date,
                position: isBull ? 'belowBar' : 'aboveBar',
                color: isBull ? '#22c55e' : isBear ? '#ef4444' : '#8b949e',
                shape: isBull ? 'arrowUp' : isBear ? 'arrowDown' : 'circle',
                text: (m.headline || '').slice(0, 13),
                size: m.importance >= 5 ? 2 : 1,
              };
            });
          try { _candleSeries.setMarkers(markers); } catch(e) {}
        }

        if (filtered.length > 0) {
          _chart.timeScale().fitContent();
        }
      }

      window.setChartPeriod = function(btn, days) {
        document.querySelectorAll('.chart-period-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        _currentDays = days;
        renderChartData(days);
      };

      // Re-apply chart colors on theme toggle
      const _origToggle = window.toggleTheme;
      window.toggleTheme = function() {
        _origToggle && _origToggle();
        if (_chart) {
          const c = chartColors();
          _chart.applyOptions({
            layout: { background: { type: 'solid', color: c.bg }, textColor: c.text },
            grid: { vertLines: { color: c.grid }, horzLines: { color: c.grid } },
          });
        }
      };

      // ── History table ──
      let _historyDays = 30;

      function renderHistory(days) {
        const tbody = document.getElementById('history-tbody');
        if (!tbody) return;
        const cutoff = cutoffDate(days);
        // reversed (newest first)
        const rows = [...nk.ohlc].reverse().filter(r => !cutoff || r.date >= cutoff);

        // Pre-compute previous close map for change calculation
        const dateIndex = {};
        nk.ohlc.forEach((r, i) => { dateIndex[r.date] = i; });

        tbody.innerHTML = rows.map(r => {
          const idx = dateIndex[r.date];
          const prev = idx > 0 ? nk.ohlc[idx - 1].close : null;
          const chg = (r.close != null && prev != null) ? r.close - prev : null;
          const chgPct = (chg != null && prev) ? chg / prev * 100 : null;
          const cls = chg == null ? '' : chg > 0 ? 'up' : chg < 0 ? 'down' : '';
          const arrow = chg == null ? '—' : chg > 0 ? '▲' : chg < 0 ? '▼' : '—';
          const dDisplay = r.date.replace(/-/g, '/');
          return `<tr>
            <td>${dDisplay}</td>
            <td>${fmtNum(r.close)}</td>
            <td class="${cls}">${chg != null ? arrow + fmtNum(Math.abs(chg)) : '—'}</td>
            <td class="${cls}">${chgPct != null ? (chgPct >= 0 ? '+' : '') + chgPct.toFixed(2) + '%' : '—'}</td>
            <td class="col-volume">${fmtVol(r.volume)}</td>
          </tr>`;
        }).join('');
      }

      window.setHistoryPeriod = function(btn, days) {
        document.querySelectorAll('.history-period-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        _historyDays = days;
        renderHistory(days);
      };

      window.downloadHistoryCsv = function() {
        const cutoff = cutoffDate(_historyDays);
        const rows = [...nk.ohlc].reverse().filter(r => !cutoff || r.date >= cutoff);
        const dateIndex = {};
        nk.ohlc.forEach((r, i) => { dateIndex[r.date] = i; });

        const header = 'date,open,high,low,close,volume,change,change_percent\n';
        const body = rows.map(r => {
          const idx = dateIndex[r.date];
          const prev = idx > 0 ? nk.ohlc[idx - 1].close : null;
          const chg = (r.close != null && prev != null) ? (r.close - prev).toFixed(2) : '';
          const chgPct = (chg !== '' && prev) ? ((r.close - prev) / prev * 100).toFixed(4) : '';
          return [r.date, r.open??'', r.high??'', r.low??'', r.close??'', r.volume??'', chg, chgPct].join(',');
        }).join('\n');
        const blob = new Blob([header + body], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `nikkei_history.csv`; a.click();
        URL.revokeObjectURL(url);
      };

      // Init on load
      document.addEventListener('DOMContentLoaded', function() {
        initChart();
        renderHistory(30);
      });
      // Also try immediately in case DOMContentLoaded already fired
      if (document.readyState !== 'loading') {
        initChart();
        renderHistory(30);
      }
    })();
  </script>

  <!-- S&P500 Chart -->
  <script>
    (function() {
      const raw = document.getElementById('market-data-json');
      if (!raw) return;
      let MARKET;
      try { MARKET = JSON.parse(raw.textContent); } catch(e) { return; }
      const sp = MARKET.sp500;
      if (!sp || !sp.ohlc || !sp.ohlc.length) return;

      function cutoffDate(days) {
        if (!days) return null;
        const d = new Date();
        d.setDate(d.getDate() - days);
        return d.toISOString().slice(0, 10);
      }
      const isDark = () =>
        (document.body.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
      function spColors() {
        return isDark()
          ? { bg: 'transparent', text: '#8b949e', grid: '#30363d', border: '#30363d', up: '#22c55e', down: '#ef4444' }
          : { bg: '#ffffff', text: '#656d76', grid: '#e5e7eb', border: '#d0d7de', up: '#16a34a', down: '#dc2626' };
      }

      let _spChart = null, _spCandle = null, _spVol = null;
      let _spDays = 30;

      function initSP500Chart() {
        const container = document.getElementById('sp500-chart');
        if (!container || typeof LightweightCharts === 'undefined') return;
        const c = spColors();
        _spChart = LightweightCharts.createChart(container, {
          layout: { background: { type: 'solid', color: c.bg }, textColor: c.text },
          grid: { vertLines: { color: c.grid }, horzLines: { color: c.grid } },
          crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
          rightPriceScale: { borderColor: c.border },
          timeScale: { borderColor: c.border, timeVisible: true },
          handleScroll: true, handleScale: true,
        });
        _spVol = _spChart.addHistogramSeries({
          color: 'rgba(100,149,237,0.4)', priceFormat: { type: 'volume' },
          priceScaleId: 'volume', scaleMargins: { top: 0.8, bottom: 0 },
        });
        _spCandle = _spChart.addCandlestickSeries({
          upColor: c.up, downColor: c.down,
          borderUpColor: c.up, borderDownColor: c.down,
          wickUpColor: c.up, wickDownColor: c.down,
          priceScaleId: 'right', scaleMargins: { top: 0.05, bottom: 0.25 },
        });
        renderSP500Data(_spDays);
        const ro = new ResizeObserver(() => {
          if (_spChart) _spChart.applyOptions({ width: container.clientWidth });
        });
        ro.observe(container);
      }

      function renderSP500Data(days) {
        if (!_spChart) return;
        const cutoff = cutoffDate(days);
        const filtered = cutoff ? sp.ohlc.filter(r => r.date >= cutoff) : sp.ohlc;
        _spCandle.setData(filtered.map(r => ({
          time: r.date, open: r.open, high: r.high, low: r.low, close: r.close,
        })));
        _spVol.setData(filtered.map(r => ({
          time: r.date, value: r.volume || 0,
          color: (r.close >= r.open) ? 'rgba(34,197,94,0.4)' : 'rgba(239,68,68,0.4)',
        })));
        if (filtered.length > 0) _spChart.timeScale().fitContent();
      }

      window.setSP500Period = function(btn, days) {
        document.querySelectorAll('#sp500-period-tabs .chart-period-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        _spDays = days;
        renderSP500Data(days);
      };

      // Initialize when S&P500 hero becomes visible
      window._initSP500Chart = initSP500Chart;
    })();
  </script>

  <!-- Index hero switcher -->
  <script>
    window.switchHeroIndex = function(btn, idx) {
      document.querySelectorAll('.idx-sel-btn').forEach(b => b.classList.toggle('active', b.dataset.idx === idx));
      const nikkeiEl = document.getElementById('market-nikkei');
