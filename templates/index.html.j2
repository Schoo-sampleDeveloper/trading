        {% if sp.open %}<span class="market-sub-item"><span class="market-sub-label">始値 </span>{{ "{:,.2f}".format(sp.open) }}</span>{% endif %}
        {% if sp.day_high %}<span class="market-sub-item"><span class="market-sub-label">高値 </span>{{ "{:,.2f}".format(sp.day_high) }}</span>{% endif %}
        {% if sp.day_low %}<span class="market-sub-item"><span class="market-sub-label">安値 </span>{{ "{:,.2f}".format(sp.day_low) }}</span>{% endif %}
      </div>

      <div class="market-hero-body">
        <div class="market-hero-left">
          <div class="chart-period-tabs" id="sp500-period-tabs">
            <button class="chart-period-btn active" data-days="30" onclick="setSP500Period(this,30)">1M</button>
            <button class="chart-period-btn" data-days="90" onclick="setSP500Period(this,90)">3M</button>
            <button class="chart-period-btn" data-days="180" onclick="setSP500Period(this,180)">6M</button>
            <button class="chart-period-btn" data-days="365" onclick="setSP500Period(this,365)">1Y</button>
          </div>
          <div class="chart-container" id="sp500-chart"></div>
          <div class="market-range-row">
            {% if sp.year_high %}
            <span class="market-range-item">
              <span class="market-range-label">年初来高値 </span>
              <span class="market-range-val up">{{ "{:,.2f}".format(sp.year_high) }}</span>
              {% if sp.year_high_date %}<span style="color:var(--text3)"> ({{ sp.year_high_date }})</span>{% endif %}
            </span>
            {% endif %}
            {% if sp.year_low %}
            <span class="market-range-item">
              <span class="market-range-label">年初来安値 </span>
              <span class="market-range-val down">{{ "{:,.2f}".format(sp.year_low) }}</span>
              {% if sp.year_low_date %}<span style="color:var(--text3)"> ({{ sp.year_low_date }})</span>{% endif %}
            </span>
            {% endif %}
          </div>
        </div><!-- /market-hero-left -->
        <div class="market-hero-right">
          <div class="insight-panel">
            <div class="insight-empty" style="font-size:0.85rem;color:var(--text2);padding:20px 0">
              🌐 S&amp;P 500<br>
              <span style="font-size:0.72rem;margin-top:6px;display:block;color:var(--text3)">
                米国株式市場の代表指数。500社の大型株で構成。
              </span>
            </div>
          </div>
        </div>
      </div><!-- /market-hero-body -->
    </div>
    {% endif %}

    <!-- News Timeline (過去30日) -->
    <div class="news-timeline-section" id="news-timeline-section">
      <div class="timeline-header">
        <div class="timeline-title">📌 過去30日のニュースタイムライン</div>
